"""
MODULE file for the TREL software onboarding sandbox.

A deliberately small version of the main repo's MODULE.bazel - same shape, just
without Python, TypeScript, Flatbuffers, embedded toolchains, and a hundred
crates on top.

Two conventions here that carry over, and that matter to you:

1. Dependencies are declared HERE, repo-wide, not per-package. A package opts
   in to an already-declared dependency in its own BUILD.bazel. The reason:
   packages in a monorepo depend on each other, so two packages wanting
   different versions of the same crate is a conflict waiting to happen. It
   also means most people never need to make a dependency decision - the
   answer is usually already declared.
2. We use bzlmod (this file), not WORKSPACE. If you ask an AI for Bazel help,
   tell it you are on bzlmod or it will confidently hand you WORKSPACE syntax
   that does nothing.
"""

module(
    name = "trel_onboarding",
    version = "0.0.1",
)

# General Bazel utilities.
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Platform (OS / CPU) definitions.
bazel_dep(name = "platforms", version = "1.0.0")

# ---------------------------------------------------------------------------
# C / C++ toolchain
#
# We pull a full LLVM toolchain down instead of using whatever clang or gcc
# happens to be installed on your laptop. That is the whole point of Bazel:
# your build does not depend on your machine. It also means `clang-format` and
# `clang-tidy` are pinned to the same version for every developer and for CI,
# so nobody argues about formatting diffs. See //tools/BUILD.bazel.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "toolchains_llvm", version = "1.6.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {"": "c++20"},
    llvm_version = "20.1.7",
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# C++ test framework, so you have something to write assertions with.
bazel_dep(name = "googletest", version = "1.17.0")

# ---------------------------------------------------------------------------
# Rust toolchain
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_rust", version = "0.70.0")

RUST_EDITION = "2024"

RUST_VERSION = "1.95.0"

# The main repo also builds for thumbv7em (the scopium flight boards) and
# wasm32. You do not need those to learn the language, so this repo sticks to
# whatever machine you are on.
RUST_TARGET_PLATFORMS = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
]

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    extra_target_triples = RUST_TARGET_PLATFORMS,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# There is no Cargo.toml in this repo, and there is none in the main repo
# either. Bazel resolves crates from the specs below.
crate.spec(
    # The crate-name feature breaks under Bazel, hence default_features = False.
    default_features = False,
    features = ["async-timeout"],
    package = "rstest",
    version = "0.26.1",
)
crate.spec(
    package = "serial_test",
    version = "3.4.0",
)
crate.from_specs(
    name = "crates",
    supported_platform_triples = RUST_TARGET_PLATFORMS,
)
use_repo(crate, "crates")
