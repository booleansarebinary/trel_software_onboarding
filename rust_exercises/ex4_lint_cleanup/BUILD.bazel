load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# NOTE THE `manual` TAGS.
#
# `manual` keeps a target out of wildcard patterns like //... - so the mess in
# this package does not break `bazel build //...` while you are working on
# the other exercises. You still build it by naming it explicitly:
#
#     bazel build //rust_exercises/ex4_lint_cleanup:channel_names
#
# Removing both `tags` attributes is part of this exercise. A target that CI
# never builds is a target that rots, and `manual` is how targets quietly stop
# being tested. Use it for genuinely special cases, not for anything
# inconvenient.
rust_library(
    name = "channel_names",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    tags = ["manual"],
)

rust_test(
    name = "tests",
    crate = ":channel_names",
    edition = "2024",
    tags = ["manual"],
    deps = ["@crates//:rstest"],
)
